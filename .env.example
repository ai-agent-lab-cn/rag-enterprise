GENERATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_BALANCE_LIMIT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_BALANCE_LIMIT=
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# 必填：向量存储只有 pgvector 一种实现，缺少它应用会拒绝启动
DATABASE_URL=
REQUIRED_DATABASE_SCHEMA_VERSION=23
UPLOAD_PATH=data/uploads
AUTH_PATH=data/auth/store.json
AUDIT_PATH=data/audit/events.json
SESSION_TTL_HOURS=12
DEMO_SEED_PATH=
FRONTEND_ORIGIN=http://localhost:5173
APP_ENVIRONMENT=development
MAX_UPLOAD_MB=15
MAX_REQUEST_BODY_MB=16
MAX_FILENAME_CHARS=160
LOGIN_RATE_LIMIT=10
EXPENSIVE_RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_EXPENSIVE_REQUESTS=4
