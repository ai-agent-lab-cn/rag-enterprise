{
  "dataset_id": "rag-enterprise-retrieval",
  "version": "1.0.0",
  "language": "zh-CN",
  "description": "用于验证 RAG Enterprise 上传、解析、切片、召回、精排、生成、评测与工程边界的合成中文数据集，不包含真实敏感信息。",
  "chunks": [
    {"chunk_id": "architecture:chunk:00000", "document_id": "architecture", "filename": "系统架构.md", "text": "系统采用 FastAPI 后端与 React 前端。前端通过相对路径 /api 调用后端，由 Nginx 在容器环境中反向代理。"},
    {"chunk_id": "architecture:chunk:00001", "document_id": "architecture", "filename": "系统架构.md", "text": "RAG 查询依次执行问题向量化、Chroma 向量召回、CrossEncoder 精排和生成模型回答。"},
    {"chunk_id": "architecture:chunk:00002", "document_id": "architecture", "filename": "系统架构.md", "text": "ChromaStore 使用进程内持久化目录保存索引，不依赖独立的 Chroma 网络服务。"},
    {"chunk_id": "architecture:chunk:00003", "document_id": "architecture", "filename": "系统架构.md", "text": "Docker Compose 编排前后端两个镜像，上传文件和 Chroma 索引分别使用后端命名卷持久化。"},
    {"chunk_id": "documents:chunk:00000", "document_id": "documents", "filename": "文档处理.md", "text": "系统接受 Markdown、TXT 和 PDF 文档，上传文件大小受到配置项限制。"},
    {"chunk_id": "documents:chunk:00001", "document_id": "documents", "filename": "文档处理.md", "text": "解析后的段落按照固定 chunk_size 和 overlap 切片，每个分块获得稳定的 chunk_id。"},
    {"chunk_id": "documents:chunk:00002", "document_id": "documents", "filename": "文档处理.md", "text": "文档标识由文件名和内容摘要共同生成，相同文件名但内容不同会得到不同 document_id。"},
    {"chunk_id": "documents:chunk:00003", "document_id": "documents", "filename": "文档处理.md", "text": "删除文档时同时删除向量索引中的相关分块以及上传目录中的原始文件。"},
    {"chunk_id": "retrieval:chunk:00000", "document_id": "retrieval", "filename": "检索设计.md", "text": "默认先召回十个候选分块，再由精排模型选出前五个来源。rerank_k 不能大于 retrieve_k。"},
    {"chunk_id": "retrieval:chunk:00001", "document_id": "retrieval", "filename": "检索设计.md", "text": "向量检索使用余弦空间，检索分数由一减距离得到；分数和精排分数都会随来源返回。"},
    {"chunk_id": "retrieval:chunk:00002", "document_id": "retrieval", "filename": "检索设计.md", "text": "Recall@5 衡量前五个向量候选对相关分块的覆盖，MRR 衡量第一个相关结果的排名。"},
    {"chunk_id": "retrieval:chunk:00003", "document_id": "retrieval", "filename": "检索设计.md", "text": "V2 质量门要求 Recall@5 不低于 0.80、向量 MRR 不低于 0.60、精排 MRR 不低于 0.70。"},
    {"chunk_id": "quality:chunk:00000", "document_id": "quality", "filename": "质量保障.md", "text": "后端质量门运行 pytest 和 Ruff，前端质量门运行测试、ESLint 和生产构建。"},
    {"chunk_id": "quality:chunk:00001", "document_id": "quality", "filename": "质量保障.md", "text": "容器质量门构建两个镜像，启动 Compose，等待健康状态并通过前端入口检查 /api/health。"},
    {"chunk_id": "quality:chunk:00002", "document_id": "quality", "filename": "质量保障.md", "text": "健康接口不得触发重量模型下载或初始化，它只返回服务、集合和模型配置状态。"},
    {"chunk_id": "quality:chunk:00003", "document_id": "quality", "filename": "质量保障.md", "text": "每个阶段使用短期 feature 分支和独立 PR，合入 main 且 CI 通过后才启动后续任务。"},
    {"chunk_id": "evaluation:chunk:00000", "document_id": "evaluation", "filename": "评测规范.md", "text": "固定评测集必须记录数据版本、稳定问题 ID、问题文本和相关分块 ID，不得包含真实敏感数据。"},
    {"chunk_id": "evaluation:chunk:00001", "document_id": "evaluation", "filename": "评测规范.md", "text": "正式报告必须记录模型标识、代码提交、运行时间、检索参数和三项检索指标。"},
    {"chunk_id": "evaluation:chunk:00002", "document_id": "evaluation", "filename": "评测规范.md", "text": "确定性模型替身只用于快速集成测试，替身产生的分数不能作为正式检索质量结果。"},
    {"chunk_id": "evaluation:chunk:00003", "document_id": "evaluation", "filename": "评测规范.md", "text": "相对已接受基线的任一指标下降超过 0.02 即视为回退，不能通过事后降低阈值制造通过。"}
  ],
